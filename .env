# Valeurs par defaut. Surcharger via .env.local (dev) ou variables d'env (prod / k8s).
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_local_secret

# Chaine de connexion MongoDB (driver ext-mongodb)
# Format: mongodb://[user:pass@]host:port/[?options]
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=electronics
